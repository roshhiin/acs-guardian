# acs-guardian/guardian.py

# 1. Define the Policy (The Rules)
DENIED_ACTIONS = [
    "delete_database",
    "send_money",
    "access_hr_files",
    "modify_production_code"
]

# 2. The Guardian Function (The Kill Switch)
def evaluate_action(agent_action):
    print(f"[AUDITOR] Agent is requesting: {agent_action}")
    
    if agent_action in DENIED_ACTIONS:
        print("[DENY] Action blocked. This violates the declared scope.")
        return "DENY"
    else:
        print("[ALLOW] Action permitted.")
        return "ALLOW"

# 3. Test the Guardian
if __name__ == "__main__":
    # Simulate a normal agent action
    evaluate_action("read_email")
    
    # Simulate a rogue agent action
    evaluate_action("delete_database")